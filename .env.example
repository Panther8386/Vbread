# Sao chép file này thành .env.local rồi điền giá trị thật (không commit .env.local lên git).

# Lấy từ Supabase Dashboard > Project Settings > API. Dùng được ở phía trình duyệt.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chỉ dùng phía máy chủ (route handler / server action). KHÔNG BAO GIỜ đưa vào code chạy trên trình duyệt.
SUPABASE_SERVICE_ROLE_KEY=
